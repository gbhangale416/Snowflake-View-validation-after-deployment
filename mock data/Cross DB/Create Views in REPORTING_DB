CREATE OR REPLACE SCHEMA REPORTING_DB.PUBLIC;

CREATE OR REPLACE VIEW REPORTING_DB.PUBLIC.VW_CUSTOMERS AS
SELECT *
FROM SALES_DB.PUBLIC.CUSTOMERS;

CREATE OR REPLACE VIEW REPORTING_DB.PUBLIC.VW_CUSTOMER_ORDERS AS
SELECT
    C.CUSTOMER_ID,
    C.CUSTOMER_NAME,
    O.ORDER_ID,
    O.AMOUNT
FROM SALES_DB.PUBLIC.CUSTOMERS C
JOIN SALES_DB.PUBLIC.ORDERS O
    ON C.CUSTOMER_ID = O.CUSTOMER_ID;
